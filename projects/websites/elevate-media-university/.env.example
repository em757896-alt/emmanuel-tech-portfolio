# ─────────────────────────────────────────────────────────────
# Copy to `.env.local` and fill in your own values. Never commit `.env.local`.
# ─────────────────────────────────────────────────────────────

# Database (Supabase PostgreSQL)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# Supabase
# NEXT_PUBLIC_* values are embedded in the browser bundle by design. Safety comes from
# Row-Level Security, NOT from hiding these. Never prefix a secret with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# SERVER ONLY — bypasses RLS. Never expose this to the browser or a mobile client.
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY="[YOUR-TURNSTILE-SITE-KEY]"

# SERVER ONLY — used to verify the captcha token. If unset, server-side captcha
# verification is skipped, so set this in any internet-facing deployment.
TURNSTILE_SECRET_KEY="[YOUR-TURNSTILE-SECRET-KEY]"

# ─────────────────────────────────────────────────────────────
# POST /api/setup — provisions the first admin/teacher/student.
# The route returns 404 unless SETUP_TOKEN is set, and requires the same value in
# the `x-setup-token` header (compared in constant time). Passwords are NEVER returned.
# ─────────────────────────────────────────────────────────────
SETUP_TOKEN="[LONG-RANDOM-STRING]"
SETUP_ADMIN_EMAIL="admin@elevatemedia.edu"
SETUP_ADMIN_PASSWORD="[ADMIN-PASSWORD]"
SETUP_TEACHER_EMAIL="sarah.jones@elevatemedia.edu"
SETUP_TEACHER_PASSWORD="[TEACHER-PASSWORD]"
SETUP_STUDENT_EMAIL="john.doe@student.elevatemedia.edu"
SETUP_STUDENT_PASSWORD="[STUDENT-PASSWORD]"
